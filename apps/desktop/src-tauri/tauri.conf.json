{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mój Asystent",
  "version": "0.1.0",
  "identifier": "pl.mojasystent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Mój Asystent",
        "width": 404,
        "height": 164,
        "minWidth": 340,
        "minHeight": 136,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
